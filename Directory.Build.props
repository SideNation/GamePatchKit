<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>TenY</Authors>
    <PackageProjectUrl>https://github.com/SideNation/GamePatchKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SideNation/GamePatchKit.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 TenY</Copyright>
    <PackageTags>game;patch;package;content-delivery</PackageTags>
  </PropertyGroup>
</Project>
