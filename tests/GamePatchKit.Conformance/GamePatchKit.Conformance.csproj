<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GamePatchKit.Core\GamePatchKit.Core.csproj" />
    <ProjectReference Include="..\..\src\GamePatchKit.Runtime\GamePatchKit.Runtime.csproj" />
    <ProjectReference Include="..\..\src\GamePatchKit.Packager\GamePatchKit.Packager.csproj" />
  </ItemGroup>

  <!-- Embedded (not copied) so the suite can reject unsigned negative manifests without depending on the
       monorepo's tests/fixtures/ layout being present at run time - the point of shipping this project as a
       source fixture to an external host. -->
  <ItemGroup>
    <EmbeddedResource Include="..\fixtures\release-manifest\invalid\*.json">
      <LogicalName>GamePatchKit.Conformance.InvalidManifestFixtures.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
